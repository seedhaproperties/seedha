{
    "expo": {
        "name": "Seedha Properties",
        "slug": "seedha-properties",
        "scheme": "seedhaproperties",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/icon.png",
        "userInterfaceStyle": "light",
        "splash": {
            "image": "./assets/splash.png",
            "resizeMode": "contain",
            "backgroundColor": "#15100E"
        },
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.muralikrishnasaripilli.seedhaproperties",
            "googleServicesFile": "./GoogleService-Info.plist"
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/adaptive-icon.png",
                "backgroundColor": "#15100E"
            },
            "package": "com.muralikrishnasaripilli.seedhaproperties",
            "googleServicesFile": "./google-services.json"
        },
        "web": {
            "bundler": "metro"
        },
        "plugins": [
            "expo-asset",
            "expo-font",
            "expo-status-bar",
            "@react-native-firebase/app",
            "@react-native-firebase/messaging",
            "react-native-nitro-google-signin",
            [
                "expo-build-properties",
                {
                    "ios": {
                        "useFrameworks": "static"
                    }
                }
            ]
        ]
    }
}